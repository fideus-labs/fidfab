#!/usr/bin/env bash
# fidfab-history-tree — hold the history rewrite (logical-commits.fabro) to the reviewed code.
#
# Usage: fidfab-history-tree record | verify | trim
#
#   record  before the rewrite: `git fetch origin`, then exit non-zero unless origin/<branch>
#           descends from the head the steward's last status check cleared
#           (.fidfab/reviews/pr-head, written by fidfab-pr-status) and is in HEAD, i.e. GitHub
#           moved only by this checkout's commits (Fabro's checkpoints). Then write three lines
#           to .fidfab/reviews/history-tree: the tree of HEAD (the code CI and reviewers saw),
#           the current branch, and the commit origin/<branch> points to. The rewrite prompt
#           reads the third line to tell Fabro's checkpoints from a push by someone else.
#   verify  after the rewrite: `git fetch origin`, then exit non-zero unless HEAD is still on the
#           recorded branch and both HEAD and origin/<branch> have the recorded tree. The
#           rewrite agent holds the run's GitHub token and is told to force-push; its prompt
#           keeps the tree, but only this check makes sure it did, also when the agent failed or
#           timed out mid-way.
#   trim    when the run has succeeded (the workflows' run_complete hook): Fabro committed and
#           pushed an empty checkpoint for every stage after the rewrite. Run verify again, then
#           move <branch> on GitHub back to the last commit that is not such a checkpoint (one
#           parent, the parent's tree, subject `fabro(...): ...`) or that predates the rewrite
#           (is in the commit GitHub had at record time), with a lease on HEAD. Nothing is done
#           without a record (no rewrite ran), or while the commit GitHub had at record time is
#           still in HEAD (the rewrite left the history as it was); trim fails, changing
#           nothing, when that commit is not in the checkout.
#
# Commits are compared by tree only, so moving, squashing and rewording pass; any change to
# the code, including a file left in the work tree that Fabro's checkpoint then committed and
# pushed, fails, and so does a branch that is no longer on GitHub (the fetch prunes).
# The record lives in the sandbox the agent can write to: this catches mistakes and an
# interrupted rewrite, not an agent that deliberately rewrites the record as well.
set -euo pipefail
file=.fidfab/reviews/history-tree
cleared=.fidfab/reviews/pr-head
tree() { git rev-parse --verify --quiet "$1^{tree}"; }
fetch() { git fetch -q --prune origin || { echo "FAIL: git fetch origin failed, cannot check what GitHub holds" >&2; exit 1; }; }
current_branch() {
  local b; b="$(git branch --show-current)"
  [[ -n "$b" ]] || { echo "FAIL: HEAD is detached, cannot tell which branch is pushed" >&2; exit 1; }
  printf '%s\n' "$b"
}
published() { git rev-parse --verify --quiet "refs/remotes/origin/$1" >/dev/null; }

case "${1:-}" in
  record)
    t="$(tree HEAD)" || { echo "fidfab-history-tree: HEAD has no tree" >&2; exit 1; }
    branch="$(current_branch)"
    fetch
    ok="$(head -n1 "$cleared" 2>/dev/null || true)"
    [[ -n "$ok" ]] || { echo "FAIL: no head from the steward's last status check ($cleared)" >&2; exit 1; }
    published "$branch" || { echo "FAIL: origin/$branch is not on GitHub" >&2; exit 1; }
    remote="$(git rev-parse "refs/remotes/origin/$branch")"
    if ! git merge-base --is-ancestor "$ok" "$remote" 2>/dev/null || ! git merge-base --is-ancestor "$remote" HEAD; then
      echo "FAIL: origin/$branch ($remote) moved since the steward cleared $ok other than by this checkout's commits" >&2
      exit 1
    fi
    mkdir -p "$(dirname "$file")"
    printf '%s\n%s\n%s\n' "$t" "$branch" "$remote" > "$file"
    echo "history tree recorded: $t (branch $branch, $remote)"
    ;;
  verify)
    [[ -s "$file" ]] || { echo "FAIL: no recorded tree ($file): the rewrite ran unchecked" >&2; exit 1; }
    { read -r want; read -r branch; read -r remote; } < "$file" || true
    [[ -n "$want" && -n "$branch" && "$remote" =~ ^([0-9a-f]{40}|[0-9a-f]{64})$ ]] ||
      { echo "FAIL: $file is incomplete, re-record before the rewrite" >&2; exit 1; }
    status=0
    now="$(current_branch)"
    if [[ "$now" != "$branch" ]]; then
      echo "FAIL: HEAD is on $now, the rewrite was recorded on $branch" >&2
      status=1
    fi
    fetch
    head_tree="$(tree HEAD || true)"
    if [[ "$head_tree" != "$want" ]]; then
      echo "FAIL: HEAD has tree ${head_tree:-none}, the reviewed tree was $want" >&2
      git diff --stat "$want" HEAD >&2 || true
      status=1
    fi
    if published "$branch"; then
      remote_tree="$(tree "refs/remotes/origin/$branch" || true)"
      if [[ "$remote_tree" != "$want" ]]; then
        echo "FAIL: origin/$branch has tree ${remote_tree:-none}, the reviewed tree was $want" >&2
        git diff --stat "$want" "refs/remotes/origin/$branch" >&2 || true
        status=1
      fi
    else
      echo "FAIL: origin/$branch was on GitHub before the rewrite and is gone now" >&2
      status=1
    fi
    [[ $status -eq 0 ]] && echo "history tree unchanged: $want ($branch, HEAD and GitHub)"
    exit $status
    ;;
  trim)
    [[ -s "$file" ]] || { echo "nothing to trim: no rewrite was recorded"; exit 0; }
    "$0" verify >/dev/null  # the same conditions, and its fetch
    { read -r _; read -r branch; read -r remote; } < "$file" || true
    # $remote bounds the scan: without it, the checkpoints Fabro added after the rewrite
    # cannot be told from the history before it.
    git cat-file -e "$remote^{commit}" 2>/dev/null || {
      echo "FAIL: $remote, which GitHub had before the rewrite, is not in this checkout: cannot tell where the rewrite began" >&2
      exit 1
    }
    if git merge-base --is-ancestor "$remote" HEAD; then
      echo "nothing to trim: the rewrite left the history as it was"
      exit 0
    fi
    # $remote is not in HEAD, so every commit of HEAD from before the rewrite is in $remote:
    # the scan stops at the first one, even when it is an empty checkpoint the rewritten
    # history ends on (a branch collapsed onto its base, say). An error counts as one too.
    predates() { git merge-base --is-ancestor "$1" "$remote" || (($? != 1)); }
    head="$(git rev-parse HEAD)"
    keep="$head"
    while read -r _ parent more < <(git rev-list --parents -n 1 "$keep") &&
      [[ -n "$parent" && -z "$more" && "$(tree "$keep")" == "$(tree "$parent")" &&
        "$(git log -1 --format=%s "$keep")" == 'fabro('*'): '* ]] && ! predates "$keep"; do
      keep="$parent"
    done
    [[ "$keep" != "$head" ]] || { echo "nothing to trim: $branch does not end with empty checkpoints"; exit 0; }
    # The lease: GitHub must hold exactly HEAD, so a commit pushed meanwhile is never dropped.
    git push -q --force-with-lease="$branch:$head" origin "$keep:refs/heads/$branch"
    echo "history trimmed: $(git rev-list --count "$keep..$head") empty checkpoints dropped, $branch is $keep on GitHub"
    ;;
  *) echo "usage: fidfab-history-tree record | verify | trim" >&2; exit 2 ;;
esac
