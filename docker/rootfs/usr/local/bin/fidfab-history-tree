#!/usr/bin/env bash
# fidfab-history-tree — hold the history rewrite (logical-commits.fabro) to the reviewed code.
#
# Usage: fidfab-history-tree record | verify
#
#   record  before the rewrite: `git fetch origin`, then write three lines to
#           .fidfab/reviews/history-tree: the tree of HEAD (the code CI and reviewers saw), the
#           current branch, and the commit origin/<branch> points to ("unpublished" when it
#           does not exist). The rewrite prompt reads the third line to tell Fabro's
#           checkpoints from a push by someone else.
#   verify  after the rewrite: `git fetch origin`, then exit non-zero unless HEAD is still on the
#           recorded branch and both HEAD and origin/<branch> have the recorded tree. The
#           rewrite agent holds the run's GitHub token and is told to force-push; its prompt
#           keeps the tree, but only this check makes sure it did, also when the agent failed or
#           timed out mid-way.
#
# Commits are compared by tree only, so moving, squashing and rewording pass; any change to
# the code, including a file left in the work tree that Fabro's checkpoint then committed and
# pushed, fails. A branch that was on GitHub at record time must still be there (the fetch
# prunes); one that was not on GitHub then is compared in HEAD only.
# The record lives in the sandbox the agent can write to: this catches mistakes and an
# interrupted rewrite, not an agent that deliberately rewrites the record as well.
set -euo pipefail
file=.fidfab/reviews/history-tree
tree() { git rev-parse --verify --quiet "$1^{tree}"; }
fetch() { git fetch -q --prune origin || { echo "FAIL: git fetch origin failed, cannot check what GitHub holds" >&2; exit 1; }; }
current_branch() {
  local b; b="$(git branch --show-current)"
  [[ -n "$b" ]] || { echo "FAIL: HEAD is detached, cannot tell which branch is pushed" >&2; exit 1; }
  printf '%s\n' "$b"
}
published() { git rev-parse --verify --quiet "refs/remotes/origin/$1" >/dev/null; }

case "${1:-}" in
  record)
    t="$(tree HEAD)" || { echo "fidfab-history-tree: HEAD has no tree" >&2; exit 1; }
    branch="$(current_branch)"
    fetch
    remote=unpublished; published "$branch" && remote="$(git rev-parse "refs/remotes/origin/$branch")"
    mkdir -p "$(dirname "$file")"
    printf '%s\n%s\n%s\n' "$t" "$branch" "$remote" > "$file"
    echo "history tree recorded: $t (branch $branch, $remote)"
    ;;
  verify)
    [[ -s "$file" ]] || { echo "FAIL: no recorded tree ($file): the rewrite ran unchecked" >&2; exit 1; }
    { read -r want; read -r branch; read -r remote; } < "$file" || true
    [[ -n "$want" && -n "$branch" && "$remote" =~ ^(unpublished|[0-9a-f]{40}|[0-9a-f]{64})$ ]] ||
      { echo "FAIL: $file is incomplete, re-record before the rewrite" >&2; exit 1; }
    status=0
    now="$(current_branch)"
    if [[ "$now" != "$branch" ]]; then
      echo "FAIL: HEAD is on $now, the rewrite was recorded on $branch" >&2
      status=1
    fi
    fetch
    head_tree="$(tree HEAD || true)"
    if [[ "$head_tree" != "$want" ]]; then
      echo "FAIL: HEAD has tree ${head_tree:-none}, the reviewed tree was $want" >&2
      git diff --stat "$want" HEAD >&2 || true
      status=1
    fi
    if published "$branch"; then
      remote_tree="$(tree "refs/remotes/origin/$branch" || true)"
      if [[ "$remote_tree" != "$want" ]]; then
        echo "FAIL: origin/$branch has tree ${remote_tree:-none}, the reviewed tree was $want" >&2
        git diff --stat "$want" "refs/remotes/origin/$branch" >&2 || true
        status=1
      fi
    elif [[ "$remote" != unpublished ]]; then
      echo "FAIL: origin/$branch was on GitHub before the rewrite and is gone now" >&2
      status=1
    else
      echo "origin/$branch was not on GitHub at record time and is not now: compared HEAD only"
    fi
    [[ $status -eq 0 ]] && echo "history tree unchanged: $want ($branch, HEAD and GitHub)"
    exit $status
    ;;
  *) echo "usage: fidfab-history-tree record | verify" >&2; exit 2 ;;
esac
