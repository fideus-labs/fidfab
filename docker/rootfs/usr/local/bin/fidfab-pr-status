#!/usr/bin/env bash
# fidfab-pr-status — summarise the open PR for this branch and emit a routing directive.
#
# Usage: fidfab-pr-status [--json]
#
# Prints a human-readable summary followed by a Fabro routing JSON object:
#   {"preferred_next_label": "work" | "done" | "no-pr", "context_updates": {...}}
#
# "done" means: no unresolved review threads, no merge conflicts with the base
# branch, and every CI check has concluded successfully. Used by the PR steward
# loop to decide whether to keep waiting or exit.
set -euo pipefail
[[ -f .fidfab/run.env ]] && set -a && . .fidfab/run.env && set +a

branch="$(git rev-parse --abbrev-ref HEAD)"
pr_json="$(gh pr view "$branch" --json number,url,mergeable,mergeStateStatus,reviewDecision,statusCheckRollup,baseRefName 2>/dev/null || true)"
if [[ -z "$pr_json" ]]; then
  echo "No open pull request for branch $branch"
  echo '{"preferred_next_label":"no-pr","context_updates":{"pr_open":false}}'
  exit 0
fi

number="$(jq -r .number <<<"$pr_json")"
url="$(jq -r .url <<<"$pr_json")"
mergeable="$(jq -r .mergeable <<<"$pr_json")"          # MERGEABLE | CONFLICTING | UNKNOWN
checks_total="$(jq '[.statusCheckRollup[]?] | length' <<<"$pr_json")"
checks_failed="$(jq '[.statusCheckRollup[]? | select((.conclusion // "") as $c | ($c|ascii_upcase) | IN("FAILURE","TIMED_OUT","CANCELLED","ACTION_REQUIRED","STARTUP_FAILURE","ERROR"))] | length' <<<"$pr_json")"
checks_pending="$(jq '[.statusCheckRollup[]? | select((.status // "COMPLETED") != "COMPLETED" or ((.conclusion // "") == "" and (.state // "") == "PENDING"))] | length' <<<"$pr_json")"

repo="$(gh repo view --json nameWithOwner -q .nameWithOwner)"
owner="${repo%%/*}"; name="${repo##*/}"
unresolved="$(gh api graphql -f query='
  query($owner:String!,$name:String!,$number:Int!){
    repository(owner:$owner,name:$name){
      pullRequest(number:$number){
        reviewThreads(first:100){ nodes { isResolved isOutdated comments(first:1){ nodes { author { login } body path line } } } }
      }
    }
  }' -F owner="$owner" -F name="$name" -F number="$number" \
  --jq '[.data.repository.pullRequest.reviewThreads.nodes[] | select(.isResolved|not)] | length' 2>/dev/null || echo 0)"

echo "PR #$number $url"
echo "  mergeable:            $mergeable"
echo "  unresolved threads:   $unresolved"
echo "  checks:               total=$checks_total failed=$checks_failed pending=$checks_pending"

label="work"
if [[ "$unresolved" == "0" && "$mergeable" == "MERGEABLE" && "$checks_failed" == "0" && "$checks_pending" == "0" ]]; then
  label="done"
elif [[ "$unresolved" == "0" && "$mergeable" == "MERGEABLE" && "$checks_failed" == "0" && "$checks_pending" != "0" ]]; then
  label="pending"
fi

jq -nc --arg l "$label" --argjson n "$number" --arg u "$url" --arg m "$mergeable" \
  --argjson ur "$unresolved" --argjson cf "$checks_failed" --argjson cp "$checks_pending" \
  '{preferred_next_label:$l, context_updates:{pr_open:true, pr_number:$n, pr_url:$u, mergeable:$m, unresolved_threads:$ur, checks_failed:$cf, checks_pending:$cp}}'
