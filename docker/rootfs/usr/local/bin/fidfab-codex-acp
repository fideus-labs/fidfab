#!/usr/bin/env bash
# fidfab-codex-acp — launch Codex as an ACP agent for a Fabro stage.
#
# Usage: fidfab-codex-acp [--model <id>] [--effort <low|medium|high|xhigh>]
#
# Model aliases:
#   luna -> ${FIDFAB_MODEL_LUNA:-gpt-5.6-luna}   (independent review)
#
# Credentials: fidfab-bootstrap writes $CODEX_HOME/auth.json from the
# CODEX_AUTH_JSON_B64 secret (ChatGPT subscription or API key). OPENAI_API_KEY
# is honoured as well. Approvals and the Codex OS sandbox are disabled because
# the stage already runs inside Fabro's Docker sandbox.
set -euo pipefail

model=""
effort=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --model)  model="$2"; shift 2 ;;
    --effort) effort="$2"; shift 2 ;;
    -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
    *) echo "fidfab-codex-acp: unknown argument $1" >&2; exit 64 ;;
  esac
done

case "$model" in
  luna|"") model="${FIDFAB_MODEL_LUNA:-gpt-5.6-luna}" ;;
esac

export CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
export NO_BROWSER=1
export INITIAL_AGENT_MODE="${INITIAL_AGENT_MODE:-agent-full-access}"

config="{\"model\":\"$model\",\"approval_policy\":\"never\",\"sandbox_mode\":\"danger-full-access\""
[[ -n "$effort" ]] && config="$config,\"model_reasoning_effort\":\"$effort\""
config="$config}"
export CODEX_CONFIG="$config"

[[ -f .fidfab/run.env ]] && set -a && . .fidfab/run.env && set +a

exec codex-acp "$@"
