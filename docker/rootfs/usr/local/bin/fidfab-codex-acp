#!/usr/bin/env bash
# fidfab-codex-acp — launch Codex as an ACP agent for a Fabro stage.
#
# Usage: fidfab-codex-acp [--model <alias|id>] [--effort <minimal|low|medium|high|xhigh>]
#
# Model aliases:
#   terra -> ${FIDFAB_MODEL_TERRA:-gpt-6.1-terra}   (independent review)
# Any other value is passed to Codex unchanged. Workflows in this repository use
# aliases only (tests/check-model-aliases.sh); pin IDs with FIDFAB_MODEL_TERRA.
# The former luna alias was replaced by terra and is rejected.
#
# Credentials: fidfab-bootstrap writes $CODEX_HOME/auth.json from the
# CODEX_AUTH_JSON_B64 secret (ChatGPT subscription or API key). OPENAI_API_KEY
# is honoured as well. Approvals and the Codex OS sandbox are disabled because
# the stage already runs inside Fabro's Docker sandbox.
set -euo pipefail

model=""
effort=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --model|--effort)
      [[ $# -ge 2 && -n "$2" ]] || { echo "fidfab-codex-acp: $1 needs a value" >&2; exit 64; }
      if [[ "$1" == --model ]]; then model="$2"; else effort="$2"; fi
      shift 2 ;;
    -h|--help) sed -n '2,15p' "$0"; exit 0 ;;
    *) echo "fidfab-codex-acp: unknown argument $1" >&2; exit 64 ;;
  esac
done

# luna was replaced by terra; fail early instead of sending "luna" to Codex as a model ID.
# Kept outside the alias block below so tests/check-model-aliases.sh does not treat it as one.
if [[ "$model" == luna ]]; then
  echo "fidfab-codex-acp: the luna alias was replaced by terra; use --model terra" \
    "(pin an ID with FIDFAB_MODEL_TERRA)" >&2
  exit 64
fi
[[ -n "${FIDFAB_MODEL_LUNA:-}" ]] && echo "fidfab-codex-acp: warning: FIDFAB_MODEL_LUNA is" \
  "ignored since luna was replaced by terra; set FIDFAB_MODEL_TERRA instead" >&2

case "$model" in
  terra|"") model="${FIDFAB_MODEL_TERRA:-gpt-6.1-terra}" ;;
esac

# CODEX_CONFIG below is JSON built by interpolation; restrict both values to plain tokens so a
# quote or backslash cannot break it or inject keys such as sandbox_mode.
if [[ ! "$model" =~ ^[A-Za-z0-9._:/-]+$ ]]; then
  echo "fidfab-codex-acp: invalid model ID '$model' (allowed: letters, digits, . _ : / -)" >&2
  exit 64
fi
case "$effort" in
  ""|minimal|low|medium|high|xhigh) ;;
  *) echo "fidfab-codex-acp: invalid --effort '$effort' (minimal|low|medium|high|xhigh)" >&2; exit 64 ;;
esac

export CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
# A forked run starts in a fresh sandbox after bootstrap ran in another one: write the
# credentials again from the secret. Its log goes to stderr, stdout carries ACP.
if [[ -n "${CODEX_AUTH_JSON_B64:-}" && ! -f "$CODEX_HOME/auth.json" ]]; then
  fidfab-bootstrap --credentials-only >&2 || true
fi
export NO_BROWSER=1
export INITIAL_AGENT_MODE="${INITIAL_AGENT_MODE:-agent-full-access}"

config="{\"model\":\"$model\",\"approval_policy\":\"never\",\"sandbox_mode\":\"danger-full-access\""
[[ -n "$effort" ]] && config="$config,\"model_reasoning_effort\":\"$effort\""
config="$config}"
export CODEX_CONFIG="$config"

[[ -f .fidfab/run.env ]] || fidfab-state restore || true   # a fork starts without .fidfab/
[[ -f .fidfab/run.env ]] && set -a && . .fidfab/run.env && set +a

# Fabro authenticates an agent that advertises a sign-in method, and only by API key. codex-acp always advertises one,
# so a ChatGPT login failed at `authenticate` ("CODEX_API_KEY or OPENAI_API_KEY is not set"). Signed in already, the
# agent advertises none, as Claude's adapter does: its answer to `initialize` loses its authMethods on the way out.
if [[ -f "$CODEX_HOME/auth.json" ]]; then
  exec node -e '
const agent = require("child_process").spawn("codex-acp", process.argv.slice(1), {stdio: ["inherit", "pipe", "inherit"]});
let rest = "";
agent.stdout.setEncoding("utf8");  // a character split across two chunks decodes whole
agent.stdout.on("data", chunk => {
  const lines = (rest + chunk).split("\n");
  rest = lines.pop();
  for (const line of lines) {
    let out = line;
    try {
      const message = JSON.parse(line);
      if (Array.isArray(message?.result?.authMethods)) { message.result.authMethods = []; out = JSON.stringify(message); }
    } catch {}
    process.stdout.write(out + "\n");
  }
});
for (const signal of ["SIGTERM", "SIGINT"]) process.on(signal, () => agent.kill(signal));
agent.on("close", code => { if (rest) process.stdout.write(rest); process.exitCode = code ?? 1; });  // exits once stdout drains
' -- "$@"
fi
exec codex-acp "$@"
