#!/usr/bin/env bash
# fidfab-codex-acp — launch Codex as an ACP agent for a Fabro stage.
#
# Usage: fidfab-codex-acp [--model <alias|id>] [--effort <low|medium|high|xhigh>]
#
# Model aliases:
#   terra -> ${FIDFAB_MODEL_TERRA:-gpt-5.6-terra}   (independent review)
# Any other value is passed to Codex unchanged. Workflows in this repository use
# aliases only (tests/check-model-aliases.sh); pin IDs with FIDFAB_MODEL_TERRA.
# The former luna alias was replaced by terra and is rejected.
#
# Credentials: fidfab-bootstrap writes $CODEX_HOME/auth.json from the
# CODEX_AUTH_JSON_B64 secret (ChatGPT subscription or API key). OPENAI_API_KEY
# is honoured as well. Approvals and the Codex OS sandbox are disabled because
# the stage already runs inside Fabro's Docker sandbox.
set -euo pipefail

model=""
effort=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --model)  model="$2"; shift 2 ;;
    --effort) effort="$2"; shift 2 ;;
    -h|--help) sed -n '2,15p' "$0"; exit 0 ;;
    *) echo "fidfab-codex-acp: unknown argument $1" >&2; exit 64 ;;
  esac
done

# luna was replaced by terra; fail early instead of sending "luna" to Codex as a model ID.
# Kept outside the alias block below so tests/check-model-aliases.sh does not treat it as one.
if [[ "$model" == luna ]]; then
  echo "fidfab-codex-acp: the luna alias was replaced by terra; use --model terra" \
    "(pin an ID with FIDFAB_MODEL_TERRA)" >&2
  exit 64
fi
[[ -n "${FIDFAB_MODEL_LUNA:-}" ]] && echo "fidfab-codex-acp: warning: FIDFAB_MODEL_LUNA is" \
  "ignored since luna was replaced by terra; set FIDFAB_MODEL_TERRA instead" >&2

case "$model" in
  terra|"") model="${FIDFAB_MODEL_TERRA:-gpt-5.6-terra}" ;;
esac

export CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
export NO_BROWSER=1
export INITIAL_AGENT_MODE="${INITIAL_AGENT_MODE:-agent-full-access}"

config="{\"model\":\"$model\",\"approval_policy\":\"never\",\"sandbox_mode\":\"danger-full-access\""
[[ -n "$effort" ]] && config="$config,\"model_reasoning_effort\":\"$effort\""
config="$config}"
export CODEX_CONFIG="$config"

[[ -f .fidfab/run.env ]] && set -a && . .fidfab/run.env && set +a

exec codex-acp "$@"
