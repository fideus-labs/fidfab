#!/usr/bin/env bash
# fidfab-coderabbit — CodeRabbit availability check and review wrapper.
#
# Usage:
#   fidfab-coderabbit available   # exit 0 if the CLI is logged in (logs in again from the key)
#   fidfab-coderabbit review      # agent-formatted review of this branch vs. the base branch,
#                                 # saved to .fidfab/reviews/coderabbit.md; exit 1 unless complete
#
# coderabbit-review.fabro stops at a gate when either fails: retry, or fall back to
# Claude's built-in review.
set -euo pipefail

[[ -f .fidfab/run.env ]] || fidfab-state restore || true   # a fork starts without .fidfab/
[[ -f .fidfab/run.env ]] && set -a && . .fidfab/run.env && set +a
# The commit the review starts from when run.env names one (a run's merge base, or FidLab's last scored version): it
# is in the branch's history, a fork's too, where a local base branch such as fidlab-scored does not exist. CodeRabbit
# still wants a branch beside it (it refuses --base-commit alone): the base branch when it is here, else this one.
branch="${FIDFAB_BASE_BRANCH:-main}"
if git cat-file -e "${FIDFAB_MERGE_BASE:-}^{commit}" 2>/dev/null; then
  git show-ref --verify --quiet "refs/heads/$branch" || branch="$(git branch --show-current)"
  base=(--base "$branch" --base-commit "$FIDFAB_MERGE_BASE")
else base=(--base "$branch"); fi

case "${1:-}" in
  available)
    command -v coderabbit >/dev/null || { echo "coderabbit: not installed" >&2; exit 1; }
    status() { timeout 60 coderabbit auth status --agent 2>&1 || true; }
    # "status":"not_authenticated" also contains the word, so read the boolean.
    authenticated() { printf '%s' "$out" | grep -qE '"authenticated" *: *true'; }
    out="$(status)"
    # A forked run starts in a fresh sandbox after bootstrap ran in another one: log in again,
    # as bootstrap does. Not through bootstrap, which would also rewrite Codex's auth.json over
    # a token Codex may have renewed since.
    if ! authenticated && [[ -n "${CODERABBIT_API_KEY:-}" ]]; then
      coderabbit auth login ${CODERABBIT_REGION:+--region "$CODERABBIT_REGION"} --api-key "$CODERABBIT_API_KEY" >/dev/null 2>&1 || true
      out="$(status)"
    fi
    if authenticated; then echo "coderabbit: available"; exit 0; fi
    echo "coderabbit: unavailable — $out" >&2
    exit 1
    ;;
  review)
    shift
    # Saved for the fix stage. Fails unless CodeRabbit finished the review: a usage limit or a
    # login error ends it early, and the workflow then stops at a gate instead of reading nothing.
    out=.fidfab/reviews/coderabbit.md
    mkdir -p .fidfab/reviews
    coderabbit review --agent "${base[@]}" "$@" | tee "$out"
    if grep '"type": *"complete"' "$out" | grep -q '"status": *"review_completed"'; then exit 0; fi
    echo "coderabbit: the review did not complete (see $out)" >&2
    exit 1
    ;;
  *)
    sed -n '2,10p' "$0"; exit 64 ;;
esac
