#!/usr/bin/env bash
# fidfab-rewrite-push — push the history the rewrite-history agent prepared, and only that.
#
# Usage: fidfab-rewrite-push
#
# The agent regroups the commits of the current branch locally and does not push. This
# script, a command node after it, pushes the result only when the content is that of the
# pull request:
#   - no rebase, merge or cherry-pick in progress, HEAD on a branch, a clean working tree;
#   - the upstream is origin/<current branch> (set by the pull request stage);
#   - after `git fetch origin`, HEAD's tree is the upstream's tree, object ID for object ID;
#   - no commit to push carries a Fabro checkpoint subject or Fabro's checkpoint metadata.
# Then it force-pushes HEAD with a lease on the exact upstream commit it compared against,
# so a push someone makes after the fetch is not overwritten. HEAD equal to the upstream
# (the agent made no changes or went back) is a successful no-op.
#
# Exit status: 0 pushed or nothing to push; 1 refused or the push failed (stderr says why).
set -euo pipefail
die() { echo "fidfab-rewrite-push: $*" >&2; exit 1; }

gitdir="$(git rev-parse --git-dir)"
for state in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD; do
  [[ ! -e "$gitdir/$state" ]] || die "a rebase, merge or cherry-pick is in progress ($state); refusing to push"
done
branch="$(git symbolic-ref -q --short HEAD)" || die "HEAD is detached; refusing to push"
[[ -z "$(git status --porcelain)" ]] || die "the working tree has uncommitted changes; refusing to push"
upstream="$(git rev-parse -q --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)" \
  || die "branch '$branch' has no upstream (no pull request was pushed); nothing to push"
[[ "$upstream" == "origin/$branch" ]] \
  || die "the upstream of '$branch' is '$upstream', expected 'origin/$branch'; refusing to push"

git fetch -q origin "+refs/heads/$branch:refs/remotes/origin/$branch" \
  || die "git fetch origin $branch failed"
head="$(git rev-parse HEAD)"
remote="$(git rev-parse "refs/remotes/origin/$branch")"
if [[ "$head" == "$remote" ]]; then
  echo "fidfab-rewrite-push: '$branch' is the pull request branch as it is; nothing to push"
  exit 0
fi

head_tree="$(git rev-parse 'HEAD^{tree}')"
remote_tree="$(git rev-parse "$remote^{tree}")"
[[ "$head_tree" == "$remote_tree" ]] \
  || die "the tree of HEAD ($head_tree) differs from the tree of origin/$branch ($remote_tree): the rewrite changed the content, or someone pushed after it started; refusing to push"

# The same patterns the agent's prompt checks for, here enforced on what goes out.
if git log --format=%B "$remote..HEAD" \
  | grep -nE '^(fabro\([^)]*\): |Fabro-[A-Za-z]+: |Co-Authored-By: Fabro <)|Generated with \[Fabro\]\(' >&2; then
  die "commits to push still carry Fabro checkpoint subjects or metadata (above); refusing to push"
fi

git push --force-with-lease="refs/heads/$branch:$remote" origin "HEAD:refs/heads/$branch" \
  || die "git push failed (a push to origin/$branch after the fetch is refused by the lease)"
echo "fidfab-rewrite-push: pushed $(git rev-list --count "$remote..HEAD") rewritten commit(s) to origin/$branch"
git log --oneline "$remote..HEAD"
