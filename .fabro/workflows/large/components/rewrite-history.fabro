// Component: rewrite-history
// Runs after the PR steward. Claude (opus) regroups the branch's commits (Fabro's
// per-stage checkpoint commits, the commit stage's summary, review fixes, the steward's
// follow-ups) into logically related commits with meaningful messages. The content of the
// branch does not change.
//
// The agent does not push. push, a command node, runs fidfab-rewrite-push: it fetches and
// force-pushes, with a lease, only if the tree is the pull request's tree, the merge base
// with the pull request's base branch is unchanged, there are no merge commits and no
// checkpoint metadata is left. The agent reads commit messages and files that run agents
// and anyone with push access wrote; that check keeps the tip tree and base of a plain
// mistake, or of an instruction planted there, from reaching the pull request. It binds
// only the tip: an intermediate commit that adds content a later one removes still passes,
// and reaches the base branch with merge-commit or rebase merging. It is not a hard boundary: every
// stage runs as root in one sandbox, and the run's GitHub token can be read there (the
// sandbox driver passes it on its command line), so an agent set on it can push past the
// check. A failed push skips to done.
//
// The steward also ends when there is no pull request and when a reply preview fails,
// which leaves threads awaiting replies. check asks fidfab-pr-status again and the
// rewrite runs only on "done": the pull request is open, green and quiet, the condition
// the steward loops for. Anything else, a failed check included, skips it. Only the
// routing line of the output is kept: the listing before it can quote review threads.
//
// The importing workflow must set `[run.run_branch] push = false` in workflow.toml.
// Fabro then keeps its checkpoint commits in the sandbox, so only what the stages push
// reaches GitHub and this rewrite is the last push. With Fabro's own pushes on, the
// checkpoint commits made after this stage would land on top of the rewritten history.
//
// fidelity="truncate" for the same reason as the steward's agents: the default preamble
// carries the output of earlier stages, which includes review-thread listings a human
// may have rejected.
digraph RewriteHistory {
  start [shape=Mdiamond, label="Start"]
  exit  [shape=Msquare,  label="Exit"]

  check   [label="PR green & quiet?", script="bash -o pipefail -c 'fidfab-pr-status | tail -n 1'",
           output_schema="routing", retry_policy="linear"]
  rewrite [label="Rewrite history (Claude opus)", class="claude opus git",
           backend="acp", acp.command="fidfab-claude-acp --model opus --effort medium",
           prompt="@prompts/rewrite-history.md", fidelity="truncate"]
  push    [label="Push if tree unchanged", script="fidfab-rewrite-push"]
  done    [shape=diamond, label="History rewritten or skipped"]

  start   -> check
  check   -> rewrite [label="done"]
  check   -> done    [condition="outcome=failed"]
  check   -> done
  rewrite -> push
  push    -> done    [condition="outcome=failed"]
  push    -> done -> exit
}
