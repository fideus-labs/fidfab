// Component: codex-review
// Independent review by Codex (terra) using the fidfab review priorities, then
// Claude (opus) verifies and addresses each finding and records the approach.
// A Codex review that fails (a usage limit, a login, any error) is done by DeepSeek
// instead, another vendor than the agent that wrote the code; its record says so. When
// DeepSeek fails too, the run stops at a gate: retry once it is lifted, or continue
// without the review, which the review records say.
digraph CodexReview {
  start [shape=Mdiamond, label="Start"]
  exit  [shape=Msquare,  label="Exit"]

  review   [label="Review (Codex terra)", class="codex terra review",
            backend="acp", acp.command="fidfab-codex-acp --model terra --effort high",
            prompt="@prompts/review-codex.md"]
  fallback [label="Review (DeepSeek), Codex unavailable", class="deepseek review",
            model="deepseek-v4-pro", provider="deepseek", reasoning_effort="high",
            prompt="@prompts/review-deepseek.md"]
  blocked  [shape=hexagon,
            label="Neither Codex nor DeepSeek could review: a usage limit, a login or another error (see the review stages in the run's log). Retry once it is lifted, or continue without the review, which the review records will say. Another Codex account takes fabro secret set and a fork from before this review. Typed text retries."]
  skipped  [label="Record the skipped independent review",
            script="mkdir -p .fidfab/reviews && echo 'Independent review skipped: neither Codex nor DeepSeek could review (a usage limit, a login or another error) and a person chose to continue without it. No independent finding was addressed.' | tee .fidfab/reviews/codex-review.md > .fidfab/reviews/codex-review-response.md"]
  address  [label="Verify & address (Claude opus)", class="claude opus verify",
            backend="acp", acp.command="fidfab-claude-acp --model opus --effort xhigh",
            prompt="@prompts/address-codex.md"]
  done     [shape=diamond, label="Codex review addressed"]

  start -> review
  review -> fallback [condition="outcome=failed"]
  review -> address
  fallback -> blocked [condition="outcome=failed"]
  fallback -> address
  blocked -> review  [label="[R] Retry the independent review"]
  blocked -> skipped [label="[C] Continue without the independent review"]
  blocked -> review  [freeform=true]  // typed text never skips the review
  skipped -> done
  address -> done
  done -> exit
}
